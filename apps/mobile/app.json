{
  "expo": {
    "name": "better-lift",
    "slug": "better-lift",
    "scheme": "better-lift",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/971f278d-f407-494e-9840-eb357fc064db"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 120,
          "backgroundColor": "#121412"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/monochrome.png",
          "color": "#f47a20"
        }
      ]
    ],
    "android": {
      "package": "com.algont.betterlift",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive.png",
        "monochromeImage": "./assets/monochrome.png",
        "backgroundColor": "#f47a20"
      }
    },
    "ios": {
      "bundleIdentifier": "com.algont.betterlift"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "971f278d-f407-494e-9840-eb357fc064db"
      }
    },
    "owner": "algont"
  }
}

# Copier vers apps/mobile/.env.
#
# Expo ne lit que le .env de ce dossier, jamais celui de la racine du monorepo.
# Une variable EXPO_PUBLIC_* placée à la racine est ignorée sans avertissement :
# le bundle retombe alors sur la valeur de repli du code.

# `localhost` désigne le TÉLÉPHONE, pas la machine de développement. Pour un
# appareil physique, mettre l'IP LAN de la machine (`ipconfig` sous Windows) ;
# téléphone et machine doivent être sur le même réseau.
#
# Émulateur Android : http://10.0.2.2:3001
# Simulateur iOS    : http://localhost:3001
EXPO_PUBLIC_API_URL="http://192.168.1.10:3001"

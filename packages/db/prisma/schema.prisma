// better-lift — schéma Prisma 7
//
// Périmètre V0 : le catalogue d'exercices seul, de quoi éprouver la chaîne
// migration → seed → API. Les modèles d'authentification, de routines, de
// séances et de records arrivent en V1 (doc 03 porte le schéma cible complet).
//
// Prisma 7 (doc 10) : générateur `prisma-client` et non `prisma-client-js`,
// `output` obligatoire, pas d'`url` dans `datasource` — elle vit dans
// prisma.config.ts —, et driver adapter requis à l'instanciation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────

/// Détermine les champs saisissables pour une série.
/// Doit rester aligné sur `ExerciseType` dans packages/core.
enum ExerciseType {
  WEIGHT_REPS // développé couché : charge + reps
  BODYWEIGHT_REPS // pompes : reps seules
  WEIGHTED_BODYWEIGHT // traction lestée : charge additionnelle + reps
  ASSISTED_BODYWEIGHT // traction assistée : charge soustraite + reps
  REPS_ONLY // reps seules, sans notion de poids de corps
  DURATION // gainage : durée
  DURATION_WEIGHT // farmer walk statique : durée + charge
  DISTANCE_DURATION // course, rameur : distance + durée
}

/// Nature d'une série, cible comme réalisée.
/// Doit rester aligné sur `SetType` dans packages/core.
enum SetType {
  WARMUP // exclue du volume et des records
  NORMAL
  FAILURE
  DROP
}

/// Unité d'affichage du profil. Les données restent en métrique quoi qu'il
/// arrive (règle non négociable n°3) : le kg/lb ne se persiste jamais.
enum UnitSystem {
  METRIC
  IMPERIAL
}

/// Visibilité d'une séance. `FOLLOWERS` n'a aucune interface avant la V2 —
/// le social est repoussé (D15) —, mais la valeur existe dès maintenant pour
/// que l'ouvrir plus tard ne demande pas de migration de données.
enum Visibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}

enum BodyPart {
  CHEST
  BACK
  SHOULDERS
  UPPER_ARMS
  LOWER_ARMS
  UPPER_LEGS
  LOWER_LEGS
  WAIST
  CARDIO
  NECK
}

// ─────────────────────────────────────────────
// Catalogue d'exercices
// ─────────────────────────────────────────────

model Exercise {
  id String @id @default(cuid())

  /// Identifiant d'origine du dataset ("0001"). Sert de clé d'idempotence au
  /// seed. Nullable dès la V1 pour les exercices créés par un utilisateur.
  externalId String? @unique
  slug       String  @unique
  name       String

  type             ExerciseType @default(WEIGHT_REPS)
  bodyPart         BodyPart
  /// Chaîne libre issue du dataset : "barbell", "dumbbell", "body weight"…
  equipment        String
  /// Muscle cible principal : "pectorals", "lats"…
  target           String
  secondaryMuscles String[]     @default([])

  thumbnailUrl String?
  animationUrl String?
  /// Mention de copyright à conserver et à afficher partout où le média
  /// apparaît (doc 08, D17).
  attribution  String?

  /// Propriétaire d'un exercice personnalisé. NULL = exercice du catalogue,
  /// visible de tous. Renseigné = visible de ce seul utilisateur.
  ///
  /// C'est la **seule** source de vérité de la distinction : le champ
  /// `isCustom` exposé par l'API en est calculé, il n'a pas de colonne. Une
  /// colonne booléenne redondante avec sa propre clé étrangère finit toujours
  /// par la contredire (voir D22).
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Permet de retirer un exercice du catalogue sans casser l'historique :
  /// un exercice référencé par une séance n'est jamais supprimé.
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations     ExerciseTranslation[]
  routineExercises RoutineExercise[]

  @@index([bodyPart])
  @@index([equipment])
  @@index([isArchived])
  /// Sert la clause de visibilité de chaque lecture du catalogue
  /// (`ownerId IS NULL OR ownerId = ?`) : les NULL sont indexés par Postgres.
  @@index([ownerId])
}

/// Nom et instructions traduits. Le dataset fournit 10 langues ; on n'importe
/// que celles réellement servies (fr, en) pour limiter la taille.

model ExerciseTranslation {
  id           String   @id @default(cuid())
  exerciseId   String
  locale       String // "fr", "en"
  name         String
  instructions String[] @default([])

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, locale])
  @@index([locale])
}

// ─────────────────────────────────────────────
// Auth — modèles Better Auth
//
// Écrits par `npx @better-auth/cli generate` depuis apps/api (doc 03).
// **Ne pas les éditer à la main** : les régénérer après tout ajout de plugin,
// le plugin Expo au premier chef. Seuls les champs applicatifs de `User`,
// clairement délimités ci-dessous, sont à réintroduire après régénération.
// ─────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // ── Champs applicatifs (hors Better Auth) ──
  // Tous ont une valeur par défaut ou sont nullables : un compte créé par
  // Better Auth, qui ne connaît pas ces colonnes, reste valide.
  username String? @unique
  bio      String? @db.VarChar(300)

  /// Unité d'**affichage** seulement. Tout reste stocké en métrique (règle non
  /// négociable n°3) : la conversion est l'affaire du client.
  unitSystem     UnitSystem @default(METRIC)
  /// Locale du profil, pas celle du navigateur : elle pilote le formatage et
  /// la langue des instructions d'exercice.
  locale         String     @default("fr")
  timezone       String     @default("Europe/Paris")
  /// Repos par défaut d'un exercice qui n'en définit pas, en secondes.
  defaultRestSec Int        @default(120)

  /// Visibilité appliquée aux nouvelles séances. `FOLLOWERS` existe dès la V1
  /// sans interface : le social est repoussé hors V2 (D15), mais avoir la
  /// valeur évite une migration de données le jour où il arrive.
  defaultVisibility Visibility @default(PRIVATE)

  /// Renseigné à la fin du parcours d'accueil. Nul tant qu'il n'a pas eu lieu.
  onboardedAt DateTime?

  /// Exercices personnalisés. Supprimer le compte les supprime avec lui (D18).
  customExercises Exercise[]
  routineFolders  RoutineFolder[]
  routines        Routine[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────
// Routines (gabarits)
//
// Une routine est un **gabarit**, une séance en sera un instantané
// indépendant (règle non négociable n°5). Rien de ce qui vit ici ne doit
// pouvoir altérer un historique déjà enregistré.
// ─────────────────────────────────────────────

model RoutineFolder {
  id       String @id @default(cuid())
  userId   String
  name     String @db.VarChar(120)
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  routines Routine[]

  @@index([userId, position])
}

model Routine {
  id       String  @id @default(cuid())
  userId   String
  folderId String?
  name     String  @db.VarChar(120)
  notes    String? @db.Text
  position Int     @default(0)

  /// Dénormalisé pour trier « dernière utilisée » sans jointure sur les séances.
  /// Écrit à la fin d'une séance, jamais calculé à la lecture.
  lastPerformedAt DateTime?
  performedCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Suppression **logique** : une séance passée peut encore désigner cette
  /// routine, et l'historique ne change jamais rétroactivement (doc 03).
  deletedAt DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Supprimer un dossier ne supprime pas ses routines : elles remontent à la
  /// racine (doc 04).
  folder RoutineFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  exercises RoutineExercise[]

  @@index([userId, deletedAt])
  @@index([folderId, position])
}

model RoutineExercise {
  id         String  @id @default(cuid())
  routineId  String
  exerciseId String
  position   Int
  notes      String? @db.VarChar(500)

  /// Surcharge le repos par défaut du profil, pour ce seul exercice.
  restSec Int?

  /// Les exercices d'une même routine partageant cette valeur non nulle
  /// forment un superset. Le modèle le porte dès la V1, l'interface viendra
  /// en V2 (D8) — avoir le champ maintenant évite une migration de données.
  supersetGroup Int?

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// `Restrict` : un exercice référencé par une routine ne s'efface pas, il
  /// s'archive (invariant 8, doc 03).
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  sets RoutineSet[]

  /// Interdit deux exercices à la même place. Corollaire à ne pas oublier :
  /// un échange naïf de positions viole la contrainte, il faut réécrire
  /// l'ensemble dans une transaction (invariant 3).
  @@unique([routineId, position])
  @@index([exerciseId])
}

/// Série **cible**. Tous les champs de valeur sont optionnels : une routine
/// peut ne prescrire qu'un nombre de séries, sans charge ni répétitions.
model RoutineSet {
  id                String  @id @default(cuid())
  routineExerciseId String
  position          Int
  type              SetType @default(NORMAL)

  /// Métrique partout, et `Decimal` jamais `Float` pour les charges
  /// (règles non négociables n°3 et 4).
  targetReps        Int?
  targetWeightKg    Decimal? @db.Decimal(7, 2)
  targetDurationSec Int?
  targetDistanceM   Decimal? @db.Decimal(9, 2)
  /// Effort perçu, de 1.0 à 10.0.
  targetRpe         Decimal? @db.Decimal(3, 1)

  routineExercise RoutineExercise @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@unique([routineExerciseId, position])
}

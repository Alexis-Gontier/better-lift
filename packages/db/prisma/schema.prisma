generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  // url et directUrl vivent désormais dans prisma.config.ts (Prisma 7).
}

enum BodyPart {
  CHEST
  BACK
  SHOULDERS
  UPPER_ARMS
  LOWER_ARMS
  UPPER_LEGS
  LOWER_LEGS
  WAIST
  CARDIO
  NECK
}

model Exercise {
  id           String    @id @default(cuid())
  // Dérivé du nom ANGLAIS, qui ne bouge jamais : c'est la clé de l'`upsert` du
  // semis, et l'identifiant de l'URL. Corriger un nom français ne le change pas.
  slug         String    @unique
  // Le nom anglais du dataset, conservé pour la recherche (D44).
  name         String
  // Le nom français, affiché. Vient de `catalogue/noms-fr.json` (D45).
  nomFr        String
  // Les deux noms dépouillés de leurs accents et de leur casse, remplis au semis
  // par `texteRecherche` de `shared` — qui passe par LA MÊME fonction que celle
  // qui normalise la saisie à la lecture (D39, D40). Deux normalisations
  // différentes rendraient la colonne inutile sans la moindre erreur.
  nomRecherche String
  instructions String[]
  bodyPart     BodyPart
  target       String
  equipment    String
  secondary    String[]
  // URL de l'animation dans le dépôt du dataset, figée sur un commit. Les médias
  // appartiennent à Gym visual : affichés avec attribution, jamais copiés (D46)
  // — voir catalogue/LICENSE-dataset.md.
  gifUrl       String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  routineExercices RoutineExercice[]
  seanceExercices  SeanceExercice[]

  @@index([bodyPart])
  @@index([equipment])
  @@index([nomRecherche])
}

// --- Better Auth ------------------------------------------------------------
// Générés par `npx auth generate`, jamais écrits de mémoire. La CLI écrit dans
// `./prisma/schema.prisma` à la racine, pas ici : les modèles ont été repris,
// le générateur et la datasource du fichier généré écartés — ils sont en
// Prisma 6 (`prisma-client-js`, `url = env(...)`) et écraseraient la
// configuration Prisma 7 du projet.
//
// `Verification` est conservé bien que la vérification d'adresse soit
// désactivée (D15) : Better Auth s'en sert aussi pour la réinitialisation de
// mot de passe.

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  routines      Routine[]
  seances       Seance[]
  preferences   Preferences?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// La limitation des tentatives de connexion (`rateLimit.storage: "database"`) :
// une ligne par couple IP + chemin. En mémoire, chaque instance Vercel aurait
// son propre compteur.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// --- Routines (lot 5) --------------------------------------------------------
// Des gabarits de séance, série par série (D47). Une routine est remplacée en
// entier à chaque enregistrement (D50), et supprimée pour de bon (D51) : une
// séance est un instantané indépendant, rien ne pointe vers elle.

enum TypeSerie {
  ECHAUFFEMENT
  NORMALE
  ECHEC
  DEGRESSIVE
}

model Routine {
  id        String   @id @default(cuid())
  userId    String
  nom       String   @db.VarChar(120)
  // Ordre dans la liste de l'utilisateur.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercices RoutineExercice[]
  seances   Seance[]

  @@index([userId, position])
}

model RoutineExercice {
  id             String @id @default(cuid())
  routineId      String
  exerciseId     String
  position       Int
  reposSec       Int?
  // D145 : le groupe de superset (D11 révisée : il entre dans l'interface).
  supersetGroupe Int?

  routine  Routine        @relation(fields: [routineId], references: [id], onDelete: Cascade)
  // Restrict : un exercice du catalogue ne se supprime pas, il s'archive.
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  series   RoutineSerie[]

  @@unique([routineId, position])
  @@index([exerciseId])
}

model RoutineSerie {
  id                String    @id @default(cuid())
  routineExerciceId String
  position          Int
  type              TypeSerie @default(NORMALE)
  repsCible         Int?
  // Toujours en kilos ; l'affichage passe par `formaterCharge` (D52).
  chargeCibleKg     Decimal?  @db.Decimal(7, 2)

  exercice RoutineExercice @relation(fields: [routineExerciceId], references: [id], onDelete: Cascade)

  @@unique([routineExerciceId, position])
}

// --- Séances (lot 6) ---------------------------------------------------------
// Un instantané de ce qui a été fait : exercices et séries y sont RECOPIÉS, et
// la séance ne dépend plus de sa routine. Aucun total stocké (D58) : volume,
// séries et durée se dérivent à la lecture.

model Seance {
  // Fourni par le client (D56) : c'est ce qui rend l'envoi rejouable sans
  // doublon depuis la file du mobile.
  id        String   @id
  userId    String
  // SetNull : supprimer une routine n'efface pas l'historique.
  routineId String?
  nom       String   @db.VarChar(120)
  debut     DateTime
  fin       DateTime
  // D130 : la note libre de la séance, écrite à la fin.
  note      String?  @db.VarChar(1000)
  createdAt DateTime @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine   Routine?         @relation(fields: [routineId], references: [id], onDelete: SetNull)
  exercices SeanceExercice[]

  @@index([userId, debut(sort: Desc)])
  @@index([routineId])
}

model SeanceExercice {
  id             String  @id @default(cuid())
  seanceId       String
  exerciseId     String
  position       Int
  reposSec       Int?
  // D90 : la note libre de l'exercice pendant la séance (« siège cran 4 »).
  note           String? @db.VarChar(500)
  // D145 : le groupe de superset, recopié de la routine ou fait en séance.
  supersetGroupe Int?

  seance   Seance        @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  series   SeanceSerie[]

  @@unique([seanceId, position])
  @@index([exerciseId])
}

model SeanceSerie {
  id               String    @id @default(cuid())
  seanceExerciceId String
  position         Int
  type             TypeSerie @default(NORMALE)
  reps             Int?
  // Toujours en kilos (D52).
  chargeKg         Decimal?  @db.Decimal(7, 2)
  faite            Boolean   @default(false)

  exercice SeanceExercice @relation(fields: [seanceExerciceId], references: [id], onDelete: Cascade)

  @@unique([seanceExerciceId, position])
}

// --- Préférences (D129) -------------------------------------------------------
// Ce qui suit le compte d'un appareil à l'autre. Une ligne par utilisateur,
// créée au premier enregistrement : sans ligne, les valeurs par défaut.

model Preferences {
  userId         String   @id
  // Séances visées par semaine, de 1 à 7 (D128).
  objectifHebdo  Int?
  // Repos des exercices sans repos propre, en secondes.
  reposDefautSec Int?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

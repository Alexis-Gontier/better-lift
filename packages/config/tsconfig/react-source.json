{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "better-lift — composants React distribués en source (voir doc 09 D24)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  }
}

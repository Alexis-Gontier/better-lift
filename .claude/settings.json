{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(npx skills *)",
      "Bash(npx biome *)",
      "Bash(npx prisma *)",
      "Bash(npx turbo *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh repo view*)",
      "Bash(adb *)",
      "Bash(eas *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.*.local)",
      "Read(./apps/**/.env)",
      "Read(./apps/**/.env.local)",
      "Read(./packages/**/.env)",
      "Bash(rm -rf *)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* ./.env)",
      "Bash(* ./.env *)",
      "Bash(* .env.local*)",
      "Bash(* .env.production*)",
      "Bash(* .env.development*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .*)",
      "Bash(git restore*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git stash drop*)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)"
    ]
  },
  "enabledPlugins": {
    "neon@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format.ps1\"",
            "timeout": 30,
            "statusMessage": "Biome"
          }
        ]
      }
    ]
  }
}

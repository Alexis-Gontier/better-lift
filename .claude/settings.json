{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev *)",
      "Bash(pnpm build *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm format)",
      "Bash(pnpm knip)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:studio)",
      "Bash(pnpm --filter * run *)",
      "Bash(turbo run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(npx expo install *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(pnpm db:reset *)",
      "Bash(prisma migrate reset *)",
      "Bash(prisma migrate deploy *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node -e 'let s=\"\";process.stdin.on(\"data\",d=>s+=d).on(\"end\",()=>{try{const p=JSON.parse(s).tool_input.file_path||\"\";if(/\\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|css)$/.test(p))console.log(p)}catch(e){}})' | { read -r f; [ -n \"$f\" ] && npx --no-install biome check --write --no-errors-on-unmatched --files-ignore-unknown=true \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Biome"
          }
        ]
      }
    ]
  }
}
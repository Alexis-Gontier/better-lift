{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.tsbuildinfo",
      "!pnpm-lock.yaml",
      "!.claude",
      "!packages/db/prisma/migrations",
      "!packages/db/seed/data",
      "!apps/web/next-env.d.ts",
      "!apps/mobile/expo-env.d.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": { "style": "inlineType" }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": { "allow": ["warn", "error"] }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [":PACKAGE:", "!@better-lift/**"],
              ":BLANK_LINE:",
              "@better-lift/**",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "apps/mobile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@better-lift/db": "Interdit : web et mobile passent toujours par l'API. Voir CLAUDE.md regle 1 et doc 09 D3.",
                  "@prisma/client": "Interdit : aucun acces Prisma hors de l'API. Voir doc 09 D3."
                },
                "patterns": [
                  {
                    "group": ["**/generated/prisma/**"],
                    "message": "Interdit : aucun acces Prisma hors de l'API. Voir doc 09 D3."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "packages/db/seed/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}

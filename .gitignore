# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/

# Cache incrémental de `tsc --build`. À ne surtout pas versionner : avec `dist/`
# ignoré, un .tsbuildinfo commité fait croire à tsc que tout est à jour et il
# n'émet plus rien sur une machine neuve — la CI compile alors contre un `dist`
# qui n'existe pas.
*.tsbuildinfo

# Prisma 7 : client généré, reconstruit par `pnpm db:generate`
packages/db/src/generated/

# Env
.env
.env.local
.env.*.local

# Config Claude Code locale — personnelle, jamais partagée
.claude/settings.local.json
CLAUDE.local.md

# Turborepo
.turbo/

# Sorties de Playwright MCP (captures, snapshots, logs de console)
.playwright-mcp/

# Expo
.expo/

# OS
.DS_Store

# Logs
*.log

# Copier vers .env à la racine du monorepo, puis renseigner.
# Un seul fichier pour tout le workspace : l'API, Prisma et les apps le lisent
# depuis la racine. Ne jamais commiter le .env (il est gitignoré).

# ─────────────────────────────────────────────
# Base de données
# Prisma 7 : ces URLs sont lues par packages/db/prisma.config.ts,
# plus par schema.prisma (doc 10).
# ─────────────────────────────────────────────

# Connexion POOLÉE (hôte en `-pooler`), utilisée au runtime par l'API.
DATABASE_URL="postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-pooler.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Connexion DIRECTE (même hôte sans `-pooler`), utilisée par les migrations :
# elles ont besoin d'une session stable, que le pooler ne garantit pas.
DIRECT_URL="postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Base fantôme de `prisma migrate dev`. Neon la provisionne seul : à ne
# renseigner que si Prisma échoue à la créer.
# SHADOW_DATABASE_URL=

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# Origines autorisées, séparées par des virgules. Jamais `*` (doc 07).
# Ajouter l'origine Expo (`exp://IP:8081`) pour tester depuis un téléphone.
CORS_ORIGINS="http://localhost:3000"

# Version renvoyée par /health et /v1/version. Injectée par la CI au déploiement.
APP_VERSION="0.0.0"

# ─────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────

BETTER_AUTH_SECRET=          # openssl rand -base64 32 — 32 caractères minimum
# URL publique de l'API : c'est elle qui construit les URL de callback OAuth.
BETTER_AUTH_URL="http://localhost:3001"

# Racine publique du web. Les liens des e-mails y reviennent, et c'est la
# comparaison de son hôte avec celui de BETTER_AUTH_URL qui décide d'activer le
# partage de cookie entre sous-domaines (nécessaire en production, inutile en
# local où les deux partagent `localhost`).
WEB_APP_URL="http://localhost:3000"

# OAuth GitHub — https://github.com/settings/developers
# Callback : <BETTER_AUTH_URL>/api/auth/callback/github
# Facultatif : sans ces deux valeurs le fournisseur n'est pas enregistré et
# l'API démarre quand même, avec l'e-mail/mot de passe seul.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub est le seul fournisseur social (doc 09 D26) : Google a été retiré, son
# OAuth App coûtait plus à tenir qu'elle ne rapportait.
#
# Apple viendra avant la première soumission iOS, pas avant (doc 04) : la règle
# App Store 4.8 ne l'impose qu'à partir du moment où l'app est soumise avec un
# autre login social. Il exige un compte Apple Developer payant.

# ─────────────────────────────────────────────
# E-mails transactionnels — doc 09 D20
# ─────────────────────────────────────────────

# Clé Resend — https://resend.com/api-keys
# Facultative en développement : sans elle, les e-mails ne partent pas et leur
# contenu (dont le lien) est écrit dans le terminal de l'API. C'est ce qui rend
# l'inscription et la réinitialisation déroulables sans compte Resend.
# REQUISE en production : l'API refuse de démarrer sans elle.
RESEND_API_KEY=

# Expéditeur, au format `Nom <adresse>`. Le domaine doit être vérifié chez
# Resend. `onboarding@resend.dev` est le bac à sable : il ne délivre qu'à
# l'adresse du compte Resend, ce qui suffit pour un premier essai.
EMAIL_FROM="better-lift <onboarding@resend.dev>"

# ─────────────────────────────────────────────
# Web
# ─────────────────────────────────────────────

NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─────────────────────────────────────────────
# Mobile
# Rien ici : Expo ne lit QUE le .env de son propre dossier. Une variable
# EXPO_PUBLIC_* placée à la racine est silencieusement ignorée — le bundle
# retombe sur la valeur de repli du code, sans le moindre avertissement.
# Voir apps/mobile/.env.example
# ─────────────────────────────────────────────

# ─────────────────────────────────────────────
# Médias
# Préfixe CDN des images et GIF d'exercices. Laisser vide tant qu'aucun bucket
# n'existe : le seed stocke alors les chemins relatifs, et le rejouer après
# configuration suffit à les compléter (doc 08).
# ─────────────────────────────────────────────

MEDIA_BASE_URL=

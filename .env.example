# Copier en `.env` à la racine. Le vrai fichier est gitignoré et l'agent ne peut pas le lire.

# --- Base de données (Neon, projet `better-lift` / late-bar-51472267, Francfort) ---
# DATABASE_URL pointe sur l'URL POOLÉE (elle contient `-pooler`) : c'est l'exécution.
# DIRECT_URL pointe sur l'URL DIRECTE : c'est ce que Prisma utilise pour migrer.
# En développement, viser la branche `dev` — jamais `production`.
# Changer de branche Neon impose de redémarrer le serveur de dev : le PrismaClient
# est mis en cache sur globalThis hors production.
DATABASE_URL="postgresql://neondb_owner:...@ep-...-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:...@ep-....eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification ---
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"

# Inscription fermée (D22) : seules ces adresses peuvent créer un compte.
# Séparées par des virgules, sans espace.
SIGNUP_ALLOWLIST="alexis.gontier03@gmail.com"

# --- Web (Vite : tout ce qui est exposé au navigateur porte le préfixe VITE_) ---
VITE_API_URL="http://localhost:3001"

# --- Mobile (Expo) ---
# Sur ÉMULATEUR Android, l'hôte se joint en 10.0.2.2 et non en localhost.
# Sur téléphone physique, mettre l'IP de la machine sur le réseau local.
EXPO_PUBLIC_API_URL="http://10.0.2.2:3001"

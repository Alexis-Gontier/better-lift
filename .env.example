# Base (lue par prisma.config.ts en v7, plus par schema.prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betterlift"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betterlift_shadow"

# API
PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,exp://192.168.1.10:8081"

# Better Auth
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Mobile
EXPO_PUBLIC_API_URL="http://192.168.1.10:3001"

# Médias
MEDIA_BASE_URL="https://cdn.better-lift.app"

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/**"],
  "ignoreDependencies": ["@prisma/client", "zod"],
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "packages/*": { "project": "src/**/*.ts" },
    "packages/config": { "entry": [], "project": [] },
    "packages/db": { "project": ["src/**/*.ts", "prisma/**/*.prisma"] },
    "apps/api": { "project": "src/**/*.ts" },
    "apps/web": {
      "entry": ["src/components/ui/**/*.{ts,tsx}", "src/lib/utils.ts"],
      "project": "src/**/*.{ts,tsx,css}"
    },
    "apps/mobile": {
      "entry": "app/**/*.{ts,tsx}",
      "project": ["app/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}"]
    }
  }
}

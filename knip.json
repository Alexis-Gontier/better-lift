{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/**"],
  "workspaces": {
    ".": { "entry": [], "project": [] },
    "packages/*": { "entry": "src/index.ts", "project": "src/**/*.ts" },
    "apps/api": { "entry": "src/index.ts", "project": "src/**/*.ts" },
    "apps/web": { "entry": "src/main.tsx", "project": "src/**/*.{ts,tsx}" }
  }
}

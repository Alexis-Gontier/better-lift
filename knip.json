{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".claude/**"],
  "ignoreDependencies": ["@prisma/client"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/*.mjs"]
    },
    "packages/*": {
      "project": "src/**/*.ts",
      "includeEntryExports": true
    },
    "packages/config": {
      "entry": [],
      "project": []
    },
    "packages/db": {
      "project": ["src/**/*.ts", "catalogue/**/*.ts", "prisma/**/*.{ts,prisma}"]
    },
    "apps/api": {
      "entry": ["src/vercel.ts"],
      "project": "src/**/*.ts"
    },
    "apps/web": {
      "entry": ["src/components/ui/**/*.{ts,tsx}", "src/lib/utils.ts"],
      "ignoreIssues": {
        "src/components/{reui,kibo-ui}/**": ["exports", "types"]
      },
      "project": "src/**/*.{ts,tsx,css}"
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "lib/utils.ts"],
      "ignoreIssues": {
        "components/ui/{text,button,input,label,icon,separator}.tsx": ["exports", "types"]
      },
      "project": ["app/**/*.{ts,tsx}", "lib/**/*.{ts,tsx}", "components/**/*.{ts,tsx}"]
    }
  }
}
